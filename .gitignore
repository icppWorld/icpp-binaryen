# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/

# The bundled Binaryen library is fetched by `make get-binaryen`, never committed
src/icpp_binaryen/lib/

# Editors / OS
.vscode/
.DS_Store

# Local scratch
*.wasm
# ...except committed test fixtures. They are test INPUTS, not build output,
# and an unanchored `*.wasm` makes `git add` skip them silently - the exact
# bug that lost a fixture in icpp-pro until CI failed on the missing file.
!test/fixtures/*.wasm
!test/parity/*.wasm

# Scratch / task-todo notes for AI agents & humans. Deliberately local-only:
# they capture in-flight plans and findings, not repo state.
TMP-*

# Cross-agent handoff documents. Local-only: one Claude Code session writes a
# task here for the session that owns another repo, which reports back in the
# same file. In-flight coordination, never repo state.
_handoff/

# The IC identity to deploy this repo to mainnet as. Per developer, per
# machine - which is exactly why it is not committed.
.icp-identity
